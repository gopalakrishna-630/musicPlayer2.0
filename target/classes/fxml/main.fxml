<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.musicplayer.controller.MainController"
            styleClass="main-window">

    <!-- Custom Title Bar -->
    <top>
        <HBox fx:id="titleBar" styleClass="title-bar" alignment="CENTER_RIGHT" spacing="10" prefHeight="35" minHeight="35">
            <padding>
                <Insets top="5" right="10" bottom="5" left="10"/>
            </padding>
            <children>
                <HBox alignment="CENTER_LEFT" HBox.hgrow="ALWAYS">
                    <children>
                        <Label text="Music Player" styleClass="title-label"/>
                    </children>
                </HBox>
                <Button text="—" onAction="#onMinimize" styleClass="window-button"/>
                <Button text="☐" onAction="#onMaximize" styleClass="window-button"/>
                <Button text="✕" onAction="#onClose" styleClass="window-close-button"/>
            </children>
        </HBox>
    </top>

    <!-- Left Sidebar -->
    <left>
        <VBox styleClass="sidebar" spacing="15">
            <padding>
                <Insets top="20" right="15" bottom="20" left="15"/>
            </padding>
            <Label text="Library" styleClass="section-header"/>
            <Button text="All Songs" onAction="#onShowAllSongs" styleClass="menu-button" maxWidth="Infinity"/>
            <Button text="Import Music" onAction="#onImport" styleClass="menu-button" maxWidth="Infinity"/>
            
            <Separator />
            
            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label text="Playlists" styleClass="section-header" HBox.hgrow="ALWAYS"/>
                <Button text="+" onAction="#onCreatePlaylist" styleClass="icon-button"/>
            </HBox>
            
            <ListView fx:id="playlistView" VBox.vgrow="ALWAYS" styleClass="playlist-list"/>
        </VBox>
    </left>

    <!-- Center Content -->
    <center>
        <VBox styleClass="content-area" spacing="10">
            <padding>
                <Insets top="20" right="20" bottom="0" left="20"/>
            </padding>
            
            <HBox spacing="10" alignment="CENTER_LEFT">
                <TextField fx:id="searchField" promptText="Search songs, artists, albums..." 
                           HBox.hgrow="ALWAYS" styleClass="search-bar"/>
                <Button text="Add to Playlist" onAction="#onAddToPlaylist" styleClass="action-button"/>
            </HBox>

            <TableView fx:id="songTable" VBox.vgrow="ALWAYS" styleClass="song-table">
                <columns>
                    <TableColumn fx:id="titleColumn" text="Title" prefWidth="250"/>
                    <TableColumn fx:id="artistColumn" text="Artist" prefWidth="200"/>
                    <TableColumn fx:id="albumColumn" text="Album" prefWidth="200"/>
                    <TableColumn fx:id="durationColumn" text="Time" prefWidth="100"/>
                </columns>
            </TableView>
        </VBox>
    </center>

    <!-- Bottom Playback Bar -->
    <bottom>
        <HBox styleClass="playback-bar" spacing="20" alignment="CENTER">
            <padding>
                <Insets top="15" right="20" bottom="15" left="20"/>
            </padding>
            
            <!-- Now Playing Info -->
            <VBox alignment="CENTER_LEFT" prefWidth="200">
                <Label fx:id="currentSongLabel" text="No song playing" styleClass="now-playing-title"/>
            </VBox>
            
            <!-- Controls -->
            <VBox alignment="CENTER" spacing="5" HBox.hgrow="ALWAYS">
                <HBox alignment="CENTER" spacing="15">
                    <Button text="⏮" onAction="#onPrevious" styleClass="control-button"/>
                    <Button fx:id="playPauseBtn" text="▶" onAction="#onPlayPause" styleClass="play-button"/>
                    <Button text="⏭" onAction="#onNext" styleClass="control-button"/>
                </HBox>
                <HBox alignment="CENTER" spacing="10" maxWidth="600">
                    <Label fx:id="currentTimeLabel" text="00:00" styleClass="time-label"/>
                    <Slider fx:id="progressSlider" HBox.hgrow="ALWAYS" styleClass="progress-slider"/>
                    <Label fx:id="totalTimeLabel" text="00:00" styleClass="time-label"/>
                </HBox>
            </VBox>
            
            <!-- Volume Control -->
            <HBox alignment="CENTER" spacing="10" prefWidth="200">
                <Label text="🔊" styleClass="icon-label"/>
                <Slider fx:id="volumeSlider" max="100" styleClass="volume-slider"/>
            </HBox>
        </HBox>
    </bottom>

</BorderPane>
